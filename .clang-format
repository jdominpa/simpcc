BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never

# === Struct/Union/Class member indentation ===
# These options control indentation of struct members to ensure consistent
# 4-space indentation for all struct/union/class members
IndentAccessModifiers: false
AccessModifierOffset: 0
NamespaceIndentation: None

BreakBeforeBraces: Linux
BraceWrapping:
  AfterControlStatement: false
  AfterFunction: true
  AfterClass: false
  AfterStruct: false
  # AfterStruct: false keeps struct opening brace on same line (K&R style)
  # Struct members will still be indented with IndentWidth: 4
  AfterUnion: false
  AfterNamespace: false
  AfterEnum: false
  BeforeCatch: false
  BeforeElse: false
  IndentBraces: false
  # IndentBraces: false ensures braces themselves are not indented,
  # but content inside braces respects IndentWidth setting

# === Braces on control statements ===
# The rule is: braces on every if/else/for/while/do body, EXCEPT when the
# body is a single statement, which may go bare whether or not it wraps onto
# further lines. Two exceptions take their braces back:
#   1. If any arm of an if/else chain needs braces, every arm gets them.
#   2. A body that is itself a control statement is braced, so that a later
#      `else` never has to be matched by eye.
#
# clang-format cannot enforce this, so neither `InsertBraces` nor
# `RemoveBracesLLVM` is set and it leaves the author's braces alone.
AllowShortIfStatementsOnASingleLine: true
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true
AllowShortBlocksOnASingleLine: Always
# AllowShortFunctionsOnASingleLine: None enforces function bodies
# to always be on separate lines, following K&R convention
AllowShortFunctionsOnASingleLine: None

# Column-align the bodies of one-line `case X: ...;` labels, so a dispatch
# table reads as a table.
AlignConsecutiveShortCaseStatements:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true
  AlignCaseColons: false

IndentCaseLabels: false
SpaceAfterCStyleCast: true
# Disable ColumnLimit
ColumnLimit: 0
MaxEmptyLinesToKeep: 1
Cpp11BracedListStyle: false
AlignTrailingComments: true
ReflowComments: true

SpacesBeforeTrailingComments: 2
IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '<[[:alnum:].]+>'
    Priority:        1
    # System headers (angle brackets) have highest priority
  - Regex:           '.*'
    Priority:        2
    # Project headers (quotes) have lower priority
SortIncludes: CaseSensitive
AlignEscapedNewlines: Left
